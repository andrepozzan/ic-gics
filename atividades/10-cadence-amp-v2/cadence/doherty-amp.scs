// Personalized Doherty PA subcircuit for the activity 9 testbench.
// The testbench and all sources live in Sim_Doherty_1.scs.
simulator lang=spectre

// Library name: IC-andrepozzan
// Cell name: doherty-amp
// View name: schematic
subckt _sub0 RF_IN RF_OUT V_B1 V_B2 V_G1 V_G2
    NM3 (net12 V_B1 net19 0) g45n1svt w=(169u) l=45n nf=20 as=14.534p \
        ad=13.52p ps=189.34u pd=172.2u nrd=473.373u nrs=508.876u sa=140n \
        sb=140n sd=160n sca=44.73329 scb=0.05021 scc=0.00569 m=(1)
    NM2 (net19 net17 0 0) g45n1svt w=(169u) l=45n nf=20 as=14.534p \
        ad=13.52p ps=189.34u pd=172.2u nrd=473.373u nrs=508.876u sa=140n \
        sb=140n sd=160n sca=44.73329 scb=0.05021 scc=0.00569 m=(1)
    NM1 (net11 V_B2 net4 0) g45n1svt w=(200u) l=45n nf=20 as=17.2p ad=16p \
        ps=223.44u pd=203.2u nrd=400u nrs=430u sa=140n sb=140n sd=160n \
        sca=44.12978 scb=0.04989 scc=0.00563 m=(1)
    NM0 (net4 net2 0 0) g45n1svt w=(150u) l=45n nf=15 as=12.6p ad=12.6p \
        ps=162.52u pd=162.52u nrd=560u nrs=560u sa=140n sb=140n sd=160n \
        sca=44.12978 scb=0.04989 scc=0.00563 m=(1)
    C18 (net1 0) capacitor c=86.57f
